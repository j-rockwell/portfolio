---
import { getCollection, render } from 'astro:content';

const projects = await getCollection('projects');
const rendered = await Promise.all(
	projects.map(async (project) => {
		const { Content } = await render(project);
		return { id: project.id, Content };
	}),
);
const projectIds = rendered.map((project) => project.id);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>John Rockwell</title>
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				document.documentElement.dataset.theme =
					stored === 'light' || stored === 'dark' ? stored : 'dark';
			})();
		</script>
	</head>
	<body>
		<div class="layout">
			<main class="intro">
				<h1>John Rockwell</h1>
				<p>orange-ya glad this isn't a tailwind site?</p>
				<p>check out my <a href="#pinscher">game engine</a>.</p>
				<p>
					find me on <a href="https://github.com/j-rockwell">github</a>,{' '}
					<a href="https://linkedin.com/in/j-rockwell">linkedin</a>, and{' '}<a
						href="https://x.com/llewkcorj">X</a>.
				</p>
				<p>if you want to chat, send me an <a href="mailto:j@jrockwell.dev">email</a>.</p>
				<p>
					<button type="button" id="theme-toggle" class="theme-toggle">too dark?</button>
				</p>
			</main>

			<aside class="panel" id="project-panel" aria-live="polite">
				{
					rendered.map(({ id, Content }) => (
						<article data-project={id}>
							<Content />
						</article>
					))
				}
			</aside>
		</div>

		<footer class="copyright">© {year} John Rockwell. All rights reserved.</footer>

		<script is:inline>
			(() => {
				const root = document.documentElement;
				const toggle = document.getElementById('theme-toggle');
				if (!toggle) return;

				const syncLabel = () => {
					toggle.textContent = `too ${root.dataset.theme === 'dark' ? 'dark' : 'bright'}?`;
				};

				syncLabel();
				toggle.addEventListener('click', () => {
					const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					localStorage.setItem('theme', next);
					syncLabel();
				});
			})();
		</script>

		<script define:vars={{ projectIds }}>
			const panel = document.getElementById('project-panel');
			const articles = panel.querySelectorAll('[data-project]');
			const ids = new Set(projectIds);

			const mobileQuery = matchMedia('(max-width: 1023px)');

			function showProject(id, { scroll = false } = {}) {
				const active = ids.has(id) ? id : null;
				articles.forEach((article) => {
					article.classList.toggle('is-active', article.dataset.project === active);
				});
				panel.classList.toggle('is-open', Boolean(active));

				if (active && scroll && mobileQuery.matches) {
					requestAnimationFrame(() => {
						panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});
				}
			}

			function idFromHash() {
				return decodeURIComponent(location.hash.slice(1));
			}

			window.addEventListener('hashchange', () => showProject(idFromHash(), { scroll: true }));
			showProject(idFromHash(), { scroll: Boolean(idFromHash()) });
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--bg: #111;
		--fg: #e8e8e8;
		--link: #8af;
		--table-border: #444;
		--table-row: #333;
		--table-header-border: #666;
		--table-header-bg: #1c1c1c;
	}

	:root[data-theme='light'] {
		color-scheme: light;
		--bg: #fff;
		--fg: #111;
		--link: #00e;
		--table-border: #ccc;
		--table-row: #ddd;
		--table-header-border: #999;
		--table-header-bg: #f5f5f5;
	}

	body {
		font-family: monospace;
		margin: 0;
		line-height: 1.5;
		background: var(--bg);
		color: var(--fg);
	}

	a {
		color: var(--link);
	}

	.layout {
		display: flex;
		flex-direction: column;
		gap: 2em;
		margin: 1em;
	}

	.intro {
		max-width: 40em;
	}

	.intro h1 {
		margin: 0 0 0.75em;
	}

	.theme-toggle {
		font: inherit;
		color: inherit;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.panel {
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.35s ease,
			visibility 0.35s ease;
	}

	.panel.is-open {
		opacity: 1;
		visibility: visible;
	}

	.panel article {
		display: none;
	}

	.panel article.is-active {
		display: block;
	}

	.panel h1 {
		font-size: 1.25em;
		margin: 0 0 0.75em;
	}

	.panel article > :first-child {
		margin-top: 0;
	}

	.panel h2 {
		font-size: 1.1em;
		margin: 2em 0 0.75em;
	}

	.panel h2:first-of-type {
		margin-top: 1.25em;
	}

	.panel p {
		margin: 0 0 0.75em;
	}

	.panel img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 0 1.5em;
	}

	.panel img:has(+ p),
	.panel p:has(> img:only-child) {
		margin-bottom: 0;
	}

	.panel img + p,
	.panel p:has(> img:only-child) + p {
		margin: 0.25em 0 1.5em;
	}

	.panel table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		margin: 0 0 2.5em;
		border: 1px solid var(--table-border);
	}

	.panel th,
	.panel td {
		padding: 0.4em 0.75em;
		text-align: left;
		font-weight: normal;
		border-bottom: 1px solid var(--table-row);
		vertical-align: top;
	}

	.panel th {
		border-bottom: 1px solid var(--table-header-border);
		background: var(--table-header-bg);
	}

	.panel tr:last-child td {
		border-bottom: none;
	}

	a[href^='http']::after {
		content: '↗';
		margin-left: 0.2em;
	}

	.copyright {
		margin: 2em 1em 1em;
		font-family: monospace;
	}

	@media (min-width: 1024px) {
		.layout {
			flex-direction: row;
			align-items: flex-start;
		}

		.intro {
			flex: 0 0 40em;
			position: sticky;
			top: 1em;
		}

		.panel {
			flex: 1;
			min-width: 0;
		}

		.panel img.img-quarter {
			width: 25%;
		}

		.panel img.img-half {
			width: 50%;
		}

		.copyright {
			position: fixed;
			bottom: 1em;
			left: 1em;
			margin: 0;
		}
	}
</style>
